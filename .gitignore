# Godot generated data
.godot/
.android/
.ci/

# Local AI / speech models
*.gguf
*.onnx
*.bin
models/downloads/
voice/models/
voice/cache/

# Runtime state / sandboxes
sandbox/
sandboxes/
user-data/

# Local Python environments and downloaded model caches
voice/.venv/
voice/venv/
computer/.venv/
file_intelligence/.venv/
file_intelligence/cache/
runtime/windows/uv/
runtime/windows/python/
runtime/windows/cache/
__pycache__/
*.pyc

# Android third-party/native build inputs are fetched by setup scripts
android_plugin/plugin/src/main/cpp/third_party/
android_plugin/plugin/libs/*.aar
android_plugin/plugin/src/main/assets/voice/
android_plugin/.gradle/
android_plugin/plugin/build/
android/

# Build / release outputs
build/output/
build/windows/
build/android/
build/release/
build/private/
build/voice_backend/
build/.voice_pyinstaller/
build/.voice_spec/
dist/
*.apk
*.aab
*.exe
*.pck

# Signing secrets never belong in Git
*.keystore
*.jks
*.p12
*.pfx

# Generated Android plugin binaries copied into the Godot project
addons/AuroraFoxRuntime/bin/*.aar
addons/AuroraFoxRuntime/bin/debug/
addons/AuroraFoxRuntime/bin/release/
