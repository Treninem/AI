{
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "aurorafox.distribution-manifest.v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "enum": [
        "model",
        "knowledge",
        "capability",
        "experience",
        "skill",
        "release"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "channel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "enum": [
        "stable",
        "beta",
        "candidate",
        "fixture"
      ]
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "min_aurorafox_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "max_aurorafox_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "platform": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "enum": [
              "windows",
              "android",
              "linux",
              "any"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "architecture": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "enum": [
              "x86_64",
              "arm64",
              "any"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "required": [
        "min_aurorafox_version",
        "max_aurorafox_version",
        "platform",
        "architecture"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "required": {
      "type": "boolean"
    },
    "optional": {
      "type": "boolean"
    },
    "resources": {
      "type": "object",
      "properties": {
        "minimum_ram": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recommended_ram": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minimum_disk": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "vram_requirement": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "minimum_ram",
        "recommended_ram",
        "minimum_disk",
        "vram_requirement"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 0,
      "maxItems": 4096,
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "version",
        "urls"
      ],
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "identifier",
        "attribution"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "record": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "content_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "shard_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "record",
        "content_bytes",
        "shard_count"
      ],
      "additionalProperties": false
    },
    "object_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "part_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "index",
          "offset",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 16384,
      "uniqueItems": true
    },
    "signature": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "enum": [
            "Ed25519"
          ]
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "additionalProperties": false
    },
    "previous_known_good": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 1024
    },
    "rollback_target": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 1024
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "enum": [
        "READY",
        "EXTERNAL_ARTIFACT_PENDING"
      ]
    }
  },
  "required": [
    "schema",
    "artifact_id",
    "artifact_type",
    "version",
    "channel",
    "provider_id",
    "filename",
    "bytes",
    "sha256",
    "content_type",
    "compatibility",
    "profile",
    "required",
    "optional",
    "resources",
    "capabilities",
    "dependencies",
    "source",
    "license",
    "provenance",
    "object_key",
    "part_size",
    "chunks",
    "signature",
    "previous_known_good",
    "rollback_target",
    "status"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aurorafox:distribution-manifest:v1",
  "title": "AuroraFox Distribution Manifest v1"
}
